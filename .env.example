# ==============================================================================
# HealthMate AI — Environment Configuration (.env.example)
# Architecture: PostgreSQL 16 (JSONB embeddings, no pgvector) + Google Gemini AI
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# PostgreSQL 16 Database Connection (No pgvector extension required)
# Uses standard PostgreSQL JSONB for storing Gemini embedding vectors.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/healthmate_ai

# Google Gemini API Configuration
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Session & Security
# Cryptographically random string (min 32 characters)
SESSION_SECRET=generate_a_random_32_character_secret_here
SESSION_DURATION_HOURS=168

# File Upload Limit
UPLOAD_MAX_SIZE_MB=10
