{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "strict": false,
    "noEmit": false
  },
  "include": ["server.ts", "server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "src", "node_modules"]
}
